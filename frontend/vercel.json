{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {"source":"/sw.js","headers":[{"key":"Cache-Control","value":"no-cache, no-store, must-revalidate"},{"key":"Service-Worker-Allowed","value":"/"}]},
    {"source":"/manifest.webmanifest","headers":[{"key":"Content-Type","value":"application/manifest+json"},{"key":"Cache-Control","value":"no-cache"}]},
    {"source":"/proposta","headers":[{"key":"X-Robots-Tag","value":"noindex, nofollow, noarchive"},{"key":"Referrer-Policy","value":"no-referrer"},{"key":"Cache-Control","value":"no-store"}]}
  ],
  "rewrites": [
    {
      "source": "/api/auth/:path*",
      "destination": "/api/proxy?target=auth/:path*"
    },
    {
      "source": "/api/v1/:path*",
      "destination": "/api/proxy?target=v1/:path*"
    },
    {
      "source": "/api/events",
      "destination": "/api/proxy?target=events"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
