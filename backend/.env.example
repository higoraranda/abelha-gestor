# Banco de dados (Neon)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Auth.js — gere com: openssl rand -base64 32
AUTH_SECRET=string_aleatoria_minimo_32_chars

# URL deste backend (em dev: localhost, em prod: URL do Fly.io)
AUTH_URL=http://localhost:3000

# URL do frontend (em dev: localhost do Vite, em prod: URL do Vercel)
FRONTEND_URL=http://localhost:5173

# Evolution API
EVOLUTION_API_URL=https://sua-evolution-api.fly.dev
EVOLUTION_API_KEY=chave_global_da_evolution_api
EVOLUTION_WEBHOOK_SECRET=string_secreta_minimo_32_chars  # openssl rand -base64 32

# Ambiente
NODE_ENV=development
PORT=3000

# Personal/PWA — somente backend. Não preencher VITE_* com estes valores.
# Gerar o par com: node scripts/generate-vapid.cjs
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu-email@example.com

# Token exclusivo do n8n (mínimo 32 caracteres aleatórios).
# A conta é resolvida no servidor; nunca aceita organization_id/user_id do payload.
ABELHA_INTEGRATION_TOKEN=
ABELHA_INTEGRATION_ORGANIZATION_ID=
ABELHA_INTEGRATION_USER_ID=
GITHUB_WEBHOOK_SECRET=

# Hosts exatos de links de lojas cujas fontes/API você autorizou. Vazio desativa ingestão/consulta.
# Autorizar um host não cria uma integração com a loja: configure o provedor no n8n.
PRICE_ALLOWED_HOSTS=
