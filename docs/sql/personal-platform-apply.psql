ws,encode(sha256(convert_to(coalesce(string_agg(to_jsonb(t)::text,E'\n' ORDER BY to_jsonb(t)::text),''),'UTF8')),'hex') AS fingerprint FROM "public"."evolution_instances" t UNION ALL SELECT 'expenses' AS table_name,count(*)::bigint AS rows,encode(sha256(convert_to(coalesce(string_agg(to_jsonb(t)::text,E'\n' ORDER BY to_jsonb(t)::text),''),'UTF8')),'hex') AS fingerprint FROM "public"."expenses" t UNION ALL SELECT 'messages' AS table_name,count(*)::bigint AS rows,encode(sha256(convert_to(coalesce(string_agg(to_jsonb(t)::text,E'\n' ORDER BY to_jsonb(t)::text),''),'UTF8')),'hex') AS fingerprint FROM "public"."messages" t UNION ALL SELECT 'notification_states' AS table_name,count(*)::bigint AS rows,encode(sha256(convert_to(coalesce(string_agg(to_jsonb(t)::text,E'\n' ORDER BY to_jsonb(t)::text),''),'UTF8')),'hex') AS fingerprint FROM "public"."notification_states" t UNION ALL SELECT 'opportunities' AS table_name,count(*)::bigint AS rows,encode(sha256(convert_to(coalesce(string_agg(to_jsonb(t)::text,E'\n' ORDER BY to_jsonb(t)::text),''),'UTF8')),'hex') AS fingerprint FROM "public"."opportunities" t UNION ALL SELECT 'organizations' AS table_name,count(*)::bigint AS rows,encode(sha256(convert_to(coalesce(string_agg(to_jsonb(t)::text,E'\n' ORDER BY to_jsonb(t)::text),''),'UTF8')),'hex') AS fingerprint FROM "public"."organizations" t UNION ALL SELECT 'receivables' AS table_name,count(*)::bigint AS rows,encode(sha256(convert_to(coalesce(string_agg(to_jsonb(t)::text,E'\n' ORDER BY to_jsonb(t)::text),''),'UTF8')),'hex') AS fingerprint FROM "public"."receivables" t UNION ALL SELECT 'reminders' AS table_name,count(*)::bigint AS rows,encode(sha256(convert_to(coalesce(string_agg(to_jsonb(t)::text,E'\n' ORDER BY to_jsonb(t)::text),''),'UTF8')),'hex') AS fingerprint FROM "public"."reminders" t UNION ALL SELECT 'users' AS table_name,count(*)::bigint AS rows,encode(sha256(convert_to(coalesce(string_agg(to_jsonb(t)::text,E'\n' ORDER BY to_jsonb(t)::text),''),'UTF8')),'hex') AS fingerprint FROM "public"."users" t) x) INTO after_rows;
 IF before_rows IS DISTINCT FROM after_rows THEN RAISE EXCEPTION 'Dados CRM divergiram: rollback obrigatório'; END IF;
 IF ARRAY(SELECT tablename::text FROM pg_tables WHERE schemaname='public' ORDER BY tablename) IS DISTINCT FROM ARRAY['catalog_items','client_contracts','client_notes','clients','companies','company_contacts','conversations','crm_lead_candidates','crm_service_drafts','delivery_tasks','evolution_instances','expenses','messages','notification_states','opportunities','organizations','personal_invoice_cycles','personal_invoice_entries','personal_milestones','personal_monthly_plans','personal_notifications','personal_preferences','personal_price_observations','personal_price_watches','personal_project_updates','personal_projects','personal_push_deliveries','personal_subscription_changes','personal_subscription_payments','personal_subscriptions','personal_weekly_reviews','push_subscriptions','receivables','reminders','users'] THEN RAISE EXCEPTION 'Esperadas exatamente35 tabelas'; END IF;
 IF (SELECT count(*) FROM pg_indexes WHERE schemaname='public')<>92 THEN RAISE EXCEPTION 'Esperados92 índices'; END IF;
 IF (SELECT count(*) FROM pg_constraint c JOIN pg_namespace n ON n.oid=c.connamespace WHERE n.nspname='public' AND c.contype<>'n')<>166 THEN RAISE EXCEPTION 'Esperadas166 constraints sem NOT NULL'; END IF;
 IF EXISTS(SELECT 1 FROM pg_constraint c JOIN pg_namespace n ON n.oid=c.connamespace WHERE n.nspname='public' AND NOT c.convalidated) OR EXISTS(SELECT 1 FROM pg_index i JOIN pg_class c ON c.oid=i.indrelid JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname='public' AND NOT i.indisvalid) THEN RAISE EXCEPTION 'Constraint ou índice inválido'; END IF;
 FOREACH target_table IN ARRAY ARRAY['personal_preferences','push_subscriptions','personal_notifications','personal_push_deliveries','personal_projects','personal_milestones','personal_project_updates','personal_invoice_cycles','personal_invoice_entries','personal_monthly_plans','personal_subscriptions','personal_subscription_payments','personal_subscription_changes','personal_price_watches','personal_price_observations','personal_weekly_reviews','crm_lead_candidates','crm_service_drafts'] LOOP
  EXECUTE format('SELECT count(*) FROM public.%I',target_table) INTO target_count;
  IF target_count<>0 THEN RAISE EXCEPTION 'Tabela nova não está vazia:%',target_table; END IF;
  IF EXISTS(SELECT 1 FROM unnest(ARRAY['SELECT','INSERT','UPDATE','DELETE']) privilege WHERE NOT has_table_privilege(current_user,format('public.%I',target_table),privilege)) THEN RAISE EXCEPTION 'Permissão ausente:%',target_table; END IF;
 END LOOP;
 IF EXISTS(SELECT 1 FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace CROSS JOIN LATERAL aclexplode(COALESCE(c.relacl,acldefault('r',c.relowner))) a WHERE n.nspname='public' AND c.relname=ANY(ARRAY['personal_preferences','push_subscriptions','personal_notifications','personal_push_deliveries','personal_projects','personal_milestones','personal_project_updates','personal_invoice_cycles','personal_invoice_entries','personal_monthly_plans','personal_subscriptions','personal_subscription_payments','personal_subscription_changes','personal_price_watches','personal_price_observations','personal_weekly_reviews','crm_lead_candidates','crm_service_drafts']) AND a.grantee=0) THEN RAISE EXCEPTION 'Permissão PUBLIC inesperada em tabela nova'; END IF;
END $verify$;
SELECT current_database() AS database,current_user AS role,18 AS new_tables,17 AS crm_tables_verified,current_timestamp AS verified_at,pg_current_wal_lsn() AS observed_lsn;
COMMIT;
