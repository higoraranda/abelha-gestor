# MODELO, sem credenciais. Não usar no serviço de produção.
# Guardar a cópia preenchida somente em secret manager/ambiente do serviço.
NODE_ENV=production
DATABASE_URL=
AUTH_SECRET=
AUTH_URL=
FRONTEND_URL=
ABELHA_INTEGRATION_TOKEN=
ABELHA_INTEGRATION_ORGANIZATION_ID=
ABELHA_INTEGRATION_USER_ID=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
GITHUB_WEBHOOK_SECRET=
PRICE_ALLOWED_HOSTS=
